digraph causal_network {
  graph [rankdir=LR, fontname=Arial];
  node [fontname=Arial];
  edge [fontname=Arial];
  "CXCL10" [label="CXCL10", shape=ellipse, style=filled, fillcolor="#ACC2DF", color="#424242"];
  "IFIT1" [label="IFIT1", shape=ellipse, style=filled, fillcolor="#B8CBE3", color="#424242"];
  "IRF1" [label="IRF1", shape=box, style=filled, fillcolor="#E08A1E", color="#006D2C"];
  "JAK1" [label="JAK1", shape=ellipse, style=filled, fillcolor="#E08A1E", color="#006D2C"];
  "PERTURBATION" [label="PERTURBATION", shape=plaintext, style=filled, fillcolor="#E08A1E", color="#424242"];
  "STAT1" [label="STAT1", shape=box, style=filled, fillcolor="#E08A1E", color="#006D2C"];
  "JAK1" -> "STAT1" [color="#D97706"];
  "JAK1" -> "IRF1" [color="#D97706"];
  "PERTURBATION" -> "JAK1" [color="#D97706"];
  "STAT1" -> "IFIT1" [color="#D97706"];
  "STAT1" -> "CXCL10" [color="#D97706"];
  "IRF1" -> "IFIT1" [color="#D97706"];
  "IRF1" -> "CXCL10" [color="#D97706"];
}
