digraph causal_network {
  graph [rankdir=LR, fontname=Helvetica];
  node [fontname=Helvetica];
  edge [fontname=Helvetica];
  "KLF2" [label="KLF2", shape=box, style=filled, fillcolor="#1F5EA8", color="#006D2C"];
  "PERTURBATION" [label="PERTURBATION", shape=plaintext, style=filled, fillcolor="#E08A1E", color="#424242"];
  "PIK3CA" [label="PIK3CA", shape=ellipse, style=filled, fillcolor="#E08A1E", color="#006D2C"];
  "THBD" [label="THBD", shape=ellipse, style=filled, fillcolor="#C0D1E7", color="#424242"];
  "PIK3CA" -> "KLF2" [color="#2563A8"];
  "PERTURBATION" -> "PIK3CA" [color="#D97706"];
  "KLF2" -> "THBD" [color="#D97706"];
}
